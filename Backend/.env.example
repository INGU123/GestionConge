# Configuration locale Backend/.env
# Ne jamais committer ce fichier contenant les secrets.

DB_USERNAME=postgres
DB_PASSWORD=REMPLACER_PAR_LE_MOT_DE_PASSE_POSTGRES

JWT_SECRET=REMPLACER_PAR_UN_SECRET_LONG_ET_ALEATOIRE

# Configuration SMTP Brevo avec SSL (port 465)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=465
MAIL_USERNAME=REMPLACER_PAR_L_IDENTIFIANT_SMTP_BREVO
MAIL_PASSWORD=REMPLACER_PAR_LA_CLE_SMTP_BREVO
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false
MAIL_FROM_EMAIL=adresse-expediteur-verifiee@example.com

FRONTEND_URL=http://localhost:3000