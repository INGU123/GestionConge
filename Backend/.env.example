# Exemple de configuration locale Backend/.env
# Copier ce fichier vers .env puis renseigner les valeurs réelles.
# Ne jamais committer le fichier .env contenant les secrets.

DB_USERNAME=postgres
DB_PASSWORD=REMPLACER_PAR_LE_MOT_DE_PASSE_POSTGRES
JWT_SECRET=REMPLACER_PAR_UN_SECRET_LONG_ET_ALEATOIRE

# Configuration officielle SMTP Brevo : serveur avec tiret entre smtp et relay
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=REMPLACER_PAR_L_IDENTIFIANT_SMTP_BREVO
MAIL_PASSWORD=REMPLACER_PAR_LA_CLE_SMTP_BREVO
MAIL_SSL_ENABLE=false
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_FROM_EMAIL=adresse-expediteur-verifiee@example.com

FRONTEND_URL=http://localhost:3000
